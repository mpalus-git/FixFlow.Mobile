{
  "openApiPath": "fixflow-api.v1.json",
  "namespace": "FixFlow.Mobile.Core.Api",
  "outputFolder": "../src/FixFlow.Mobile.Core/Api",
  "outputFilename": "FixFlowApi.g.cs",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "FixFlowApi"
  },
  "includePathMatches": [
    "^/api/v1/auth/(login|refresh|logout)$",
    "^/api/v1/users/me$",
    "^/api/v1/work-orders$",
    "^/api/v1/work-orders/[{]workOrderId[}]$",
    "^/api/v1/work-orders/[{]workOrderId[}]/(start|complete|protocol|service-entries)$",
    "^/api/v1/parts$",
    "^/api/v1/parts/[{]partId[}]$",
    "^/api/v1/clients/[{]clientId[}]$",
    "^/api/v1/devices/[{]deviceId[}]$",
    "^/api/v1/devices/[{]deviceId[}]/work-orders$"
  ],
  "trimUnusedSchema": true,
  "keepSchemaPatterns": [
    "^ProblemDetails$",
    "^HttpValidationProblemDetails$"
  ],
  "useCancellationTokens": true,
  "returnIApiResponse": true,
  "responseTypeOverride": {
    "GetServiceProtocol": "IApiResponse<System.IO.Stream>"
  },
  "operationNameTemplate": "{operationName}Async",
  "generateXmlDocCodeComments": false,
  "generateStatusCodeComments": false,
  "addAutoGeneratedHeader": false,
  "immutableRecords": true,
  "useIsoDateFormat": true,
  "skipDefaultAdditionalProperties": true,
  "codeGeneratorSettings": {
    "dateType": "System.DateOnly",
    "dateTimeType": "System.DateTimeOffset",
    "generateNullableReferenceTypes": true,
    "generateOptionalPropertiesAsNullable": true
  }
}
