<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FixFlow.Mobile.Controls"
             x:Class="FixFlow.Mobile.Controls.OfflineBanner"
             x:Name="Root">
    <Border x:DataType="controls:OfflineBanner"
            StrokeThickness="0"
            Padding="16,12"
            BackgroundColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
        <Label Text="{Binding Message, Source={x:Reference Root}}"
               Style="{StaticResource SecondaryLabel}"
               SemanticProperties.Description="{Binding Message, Source={x:Reference Root}}" />
    </Border>
</ContentView>
