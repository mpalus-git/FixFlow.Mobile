<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(FixFlowPlatform)' == 'windows'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FixFlow.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>FixFlow</ApplicationTitle>
    <ApplicationId>io.github.mpalusgit.fixflow</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CiCheckBuild)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup>
    <FixFlowApiBaseUrl Condition="'$(FixFlowApiBaseUrl)' == '' and '$(Configuration)' == 'Release'">https://fixflow-api-us2p.onrender.com</FixFlowApiBaseUrl>
    <FixFlowApiBaseUrl Condition="'$(FixFlowApiBaseUrl)' == '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">http://10.0.2.2:8080</FixFlowApiBaseUrl>
    <FixFlowApiBaseUrl Condition="'$(FixFlowApiBaseUrl)' == ''">http://localhost:8080</FixFlowApiBaseUrl>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0D736A" />
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" Include="Resources\AppIcon\Windows\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D736A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\brandmark.svg" BaseSize="40,40" />
    <MauiImage Include="Resources\Images\sync_dark.svg" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\sync_light.svg" BaseSize="24,24" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Include="Platforms\Android\NetworkSecurity\$(Configuration)\network_security_config.xml"
                     Link="Platforms\Android\Resources\xml\network_security_config.xml" />
    <PackageReference Include="Plugin.LocalNotification" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FixFlow.Mobile.Core\FixFlow.Mobile.Core.csproj" />
  </ItemGroup>
  <Target Name="GenerateBuildConfiguration" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <BuildConfigurationFile>$(IntermediateOutputPath)BuildConfiguration.g.cs</BuildConfigurationFile>
      <DemoTechnicianEmailLiteral>$([MSBuild]::Escape($(DemoTechnicianEmail.Replace('"', '""'))))</DemoTechnicianEmailLiteral>
      <DemoTechnicianPasswordLiteral>$([MSBuild]::Escape($(DemoTechnicianPassword.Replace('"', '""'))))</DemoTechnicianPasswordLiteral>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(BuildConfigurationFile)"
      Lines="namespace FixFlow.Mobile%3B;internal static class BuildConfiguration;{;    public const string ApiBaseUrl = &quot;$(FixFlowApiBaseUrl)&quot;%3B;    public const string DemoTechnicianEmail = @&quot;$(DemoTechnicianEmailLiteral)&quot;%3B;    public const string DemoTechnicianPassword = @&quot;$(DemoTechnicianPasswordLiteral)&quot;%3B;    public const string ApplicationDisplayVersion = &quot;$(ApplicationDisplayVersion)&quot;%3B;    public const string ApplicationVersion = &quot;$(ApplicationVersion)&quot;%3B;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildConfigurationFile)" />
      <FileWrites Include="$(BuildConfigurationFile)" />
    </ItemGroup>
  </Target>
</Project>
