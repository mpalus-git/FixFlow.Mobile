<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:FixFlow.Mobile.Core.Resources;assembly=FixFlow.Mobile.Core"
             xmlns:viewModels="clr-namespace:FixFlow.Mobile.Core.Features.Auth;assembly=FixFlow.Mobile.Core"
             x:Class="FixFlow.Mobile.Features.Auth.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="{x:Static resources:AppResources.LoginTitle}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,48"
                             Spacing="16"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                             WidthRequest="{OnIdiom Phone=-1, Default=468}">
            <HorizontalStackLayout Spacing="12"
                                   HorizontalOptions="Center">
                <Image Source="brandmark.png"
                       WidthRequest="40"
                       HeightRequest="40"
                       VerticalOptions="Center" />
                <Label Text="{x:Static resources:AppResources.AppName}"
                       Style="{StaticResource HeadlineLabel}"
                       FontSize="32"
                       VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />
            </HorizontalStackLayout>
            <Label Text="{x:Static resources:AppResources.LoginSubtitle}"
                   Style="{StaticResource SecondaryLabel}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,16" />

            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static resources:AppResources.LoginEmailLabel}"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Email}"
                           Keyboard="Email"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False"
                           ReturnType="Next"
                           SemanticProperties.Description="{x:Static resources:AppResources.LoginEmailLabel}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static resources:AppResources.LoginPasswordLabel}"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Password}"
                           IsPassword="True"
                           ReturnType="Go"
                           ReturnCommand="{Binding LoginCommand}"
                           SemanticProperties.Hint="{OnPlatform Android={x:Static resources:AppResources.LoginPasswordLabel}}"
                           SemanticProperties.Description="{OnPlatform WinUI={x:Static resources:AppResources.LoginPasswordLabel}}" />
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   SemanticProperties.Description="{Binding ErrorMessage}" />

            <HorizontalStackLayout Spacing="12"
                                   IsVisible="{Binding HasStatusMessage}">
                <ActivityIndicator IsRunning="{Binding HasStatusMessage}"
                                   HeightRequest="20"
                                   WidthRequest="20" />
                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryLabel}"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Button Text="{x:Static resources:AppResources.LoginButton}"
                    Command="{Binding LoginCommand}"
                    Margin="0,8,0,0" />
            <Button Text="{x:Static resources:AppResources.DemoLoginButton}"
                    Command="{Binding DemoLoginCommand}"
                    IsVisible="{Binding IsDemoLoginAvailable}"
                    Style="{StaticResource OutlineButton}" />
            <ActivityIndicator IsRunning="{Binding LoginCommand.IsRunning}"
                               IsVisible="{Binding LoginCommand.IsRunning}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
