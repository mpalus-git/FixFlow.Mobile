<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FixFlow.Mobile.Controls"
             xmlns:resources="clr-namespace:FixFlow.Mobile.Core.Resources;assembly=FixFlow.Mobile.Core"
             xmlns:viewModels="clr-namespace:FixFlow.Mobile.Core.Features.WorkOrders;assembly=FixFlow.Mobile.Core"
             x:Class="FixFlow.Mobile.Features.WorkOrders.WorkOrderListPage"
             x:DataType="viewModels:WorkOrderListViewModel"
             Title="{x:Static resources:AppResources.WorkOrderListTitle}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static resources:AppResources.SyncTitle}"
                     Command="{Binding OpenSyncCommand}" />
        <ToolbarItem Text="{x:Static resources:AppResources.SettingsTitle}"
                     Command="{Binding OpenSettingsCommand}"
                     Order="Secondary" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <controls:StatusBanner IsVisible="{Binding Screen.HasBanner}"
                               Text="{Binding Screen.Banner.Text}"
                               Tone="{Binding Screen.Banner.Tone}"
                               HasAction="{Binding Screen.Banner.HasQueueAction}"
                               ActionCommand="{Binding OpenSyncCommand}" />

        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView Style="{StaticResource ReadableContent}"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedWorkOrder}"
                            SelectionChangedCommand="{Binding OpenSelectedWorkOrderCommand}">
                <CollectionView.EmptyView>
                    <controls:EmptyView Message="{x:Static resources:AppResources.WorkOrderListEmpty}" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewModels:WorkOrderGroup">
                        <Label Text="{Binding Title}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Padding="16,20,16,8"
                               SemanticProperties.HeadingLevel="Level2" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:WorkOrderListItem">
                        <Grid Padding="16,4">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="2">
                                    <Label Text="{Binding Number}"
                                           FontAttributes="Bold" />
                                    <controls:Badge Grid.Column="1"
                                                    Text="{Binding StatusText}"
                                                    Tone="{Binding StatusTone}" />
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding ClientName}" />
                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding DeviceModel}"
                                           Style="{StaticResource SecondaryLabel}" />
                                    <Label Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding DateText}"
                                           Style="{StaticResource SecondaryLabel}" />
                                    <Label Grid.Row="5"
                                           Grid.ColumnSpan="2"
                                           Text="{x:Static resources:AppResources.PendingSyncLabel}"
                                           IsVisible="{Binding IsPending}"
                                           Style="{StaticResource SecondaryLabel}"
                                           FontAttributes="Italic" />
                                    <Label Grid.Row="5"
                                           Grid.ColumnSpan="2"
                                           Text="{x:Static resources:AppResources.WorkOrderRejectedChange}"
                                           IsVisible="{Binding HasRejectedChange}"
                                           Style="{StaticResource ErrorLabel}" />
                                    <controls:Badge Grid.Row="4"
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding PriorityText}"
                                                    Tone="{Binding PriorityTone}"
                                                    IsVisible="{Binding IsUrgent}"
                                                    HorizontalOptions="Start"
                                                    Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16"
                             Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <controls:LoadingView Grid.Row="1"
                              Style="{StaticResource ScreenOverlay}"
                              IsVisible="{Binding Screen.IsLoading}" />
        <controls:ErrorView Grid.Row="1"
                            Style="{StaticResource ScreenOverlay}"
                            IsVisible="{Binding Screen.IsError}"
                            Message="{Binding Screen.ErrorMessage}"
                            RetryCommand="{Binding RefreshCommand}" />
    </Grid>
</ContentPage>
