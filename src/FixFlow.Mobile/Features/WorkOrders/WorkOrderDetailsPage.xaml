<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FixFlow.Mobile.Controls"
             xmlns:resources="clr-namespace:FixFlow.Mobile.Core.Resources;assembly=FixFlow.Mobile.Core"
             xmlns:serviceEntries="clr-namespace:FixFlow.Mobile.Core.Features.ServiceEntries;assembly=FixFlow.Mobile.Core"
             xmlns:viewModels="clr-namespace:FixFlow.Mobile.Core.Features.WorkOrders;assembly=FixFlow.Mobile.Core"
             x:Class="FixFlow.Mobile.Features.WorkOrders.WorkOrderDetailsPage"
             x:DataType="viewModels:WorkOrderDetailsViewModel"
             Title="{Binding Details.Number}">
    <Grid RowDefinitions="Auto,Auto,*">
        <controls:OfflineBanner IsVisible="{Binding Screen.IsOffline}"
                                Message="{Binding Screen.OfflineMessage}" />
        <controls:OfflineBanner Grid.Row="1"
                                IsVisible="{Binding HasNotice}"
                                Message="{Binding Notice}" />

        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout
                                     Padding="16"
                                     Spacing="12">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Details.Number}"
                                       Style="{StaticResource HeadlineLabel}"
                                       HorizontalTextAlignment="Start"
                                       SemanticProperties.HeadingLevel="Level1" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource StatusBadge}">
                                    <Label Text="{Binding Details.StatusText}"
                                           FontSize="12" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Details.DueText}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{Binding Details.PriorityText}"
                                   IsVisible="{Binding Details.IsUrgent}"
                                   Style="{StaticResource ErrorLabel}" />
                            <Label Text="{Binding Details.Description}"
                                   Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="{x:Static resources:AppResources.StartWorkButton}"
                            Command="{Binding StartWorkCommand}"
                            IsVisible="{Binding CanStartWork}" />
                    <Label Text="{Binding StartBlockedText}"
                           IsVisible="{Binding HasStartBlockedText}"
                           Style="{StaticResource SecondaryLabel}" />

                    <Label Text="{x:Static resources:AppResources.WorkTimerSection}"
                           Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding HasWorkTimer}" />
                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding HasWorkTimer}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding WorkTimer.StartedText}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding WorkTimer.ElapsedText}" />
                            <Grid ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding WorkTimer.HasLocationText}">
                                <ActivityIndicator IsRunning="{Binding WorkTimer.IsLocating}"
                                                   IsVisible="{Binding WorkTimer.IsLocating}"
                                                   HeightRequest="20"
                                                   WidthRequest="20"
                                                   Margin="0,0,8,0" />
                                <Label Grid.Column="1"
                                       Text="{Binding WorkTimer.LocationText}"
                                       Style="{StaticResource SecondaryLabel}" />
                            </Grid>
                            <VerticalStackLayout Spacing="8"
                                                 Margin="0,8,0,0"
                                                 IsVisible="{Binding WorkTimer.CanRetryLocation}">
                                <Button Text="{x:Static resources:AppResources.RetryLocationButton}"
                                        Command="{Binding RetryLocationCommand}"
                                        Style="{StaticResource OutlineButton}" />
                                <Button Text="{x:Static resources:AppResources.OpenLocationSettingsButton}"
                                        Command="{Binding OpenLocationSettingsCommand}"
                                        IsVisible="{Binding WorkTimer.CanOpenLocationSettings}"
                                        Style="{StaticResource OutlineButton}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="{x:Static resources:AppResources.AddEntryButton}"
                            Command="{Binding AddEntryCommand}"
                            IsVisible="{Binding CanAddEntry}" />

                    <Label Text="{x:Static resources:AppResources.DetailsClientSection}"
                           Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding Details.HasClient}" />
                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding Details.HasClient}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Details.Client.Name}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Details.Client.ContactText}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{Binding Details.Client.AddressText}" />
                            <Label Text="{Binding Details.Client.Phone}" />
                            <VerticalStackLayout Spacing="8"
                                                 Margin="0,8,0,0">
                                <Button Text="{x:Static resources:AppResources.DetailsCallButton}"
                                        Command="{Binding CallClientCommand}"
                                        Style="{StaticResource OutlineButton}" />
                                <Button Text="{x:Static resources:AppResources.DetailsOpenMapButton}"
                                        Command="{Binding OpenAddressCommand}"
                                        Style="{StaticResource OutlineButton}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{x:Static resources:AppResources.DetailsDeviceSection}"
                           Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding Details.HasDevice}" />
                    <Border Style="{StaticResource CardBorder}"
                            IsVisible="{Binding Details.HasDevice}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Details.Device.Name}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Details.Device.SerialNumberText}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{Binding Details.Device.InstalledText}"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{x:Static resources:AppResources.DetailsEntriesSection}"
                           Style="{StaticResource SectionLabel}" />
                    <Label Text="{x:Static resources:AppResources.DetailsNoEntries}"
                           Style="{StaticResource SecondaryLabel}"
                           IsVisible="{Binding Details.HasNoEntries}" />
                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Details.Entries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="serviceEntries:ServiceEntryView">
                                <Border Style="{StaticResource CardBorder}">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding TechnicianName}"
                                                   FontAttributes="Bold" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource StatusBadge}"
                                                    IsVisible="{Binding IsCorrection}">
                                                <Label Text="{x:Static resources:AppResources.DetailsCorrectionBadge}"
                                                       FontSize="12" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding CreatedText}"
                                               Style="{StaticResource SecondaryLabel}" />
                                        <Label Text="{x:Static resources:AppResources.PendingSyncLabel}"
                                               IsVisible="{Binding IsPending}"
                                               Style="{StaticResource SecondaryLabel}"
                                               FontAttributes="Italic" />
                                        <Label Text="{Binding Note}" />
                                        <Label Text="{Binding WorkTimeText}"
                                               Style="{StaticResource SecondaryLabel}"
                                               IsVisible="{Binding HasWorkTime}" />
                                        <VerticalStackLayout Spacing="6"
                                                             Margin="0,4,0,0"
                                                             IsVisible="{Binding HasParts}"
                                                             BindableLayout.ItemsSource="{Binding Parts}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="serviceEntries:ServiceEntryPartView">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          RowDefinitions="Auto,Auto">
                                                        <Label Text="{Binding Name}" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding AmountText}"
                                                               FontAttributes="Bold" />
                                                        <Label Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Style="{StaticResource SecondaryLabel}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding CatalogNumber}" />
                                                                    <Span Text="  ·  " />
                                                                    <Span Text="{Binding QuantityText}" />
                                                                    <Span Text=" × " />
                                                                    <Span Text="{Binding UnitPriceText}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <FlexLayout Wrap="Wrap"
                                                    Margin="0,8,0,0"
                                                    IsVisible="{Binding HasPhotos}"
                                                    BindableLayout.ItemsSource="{Binding Photos}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="serviceEntries:EntryPhotoView">
                                                    <Grid Padding="0,0,8,8">
                                                        <ImageButton Source="{Binding Source}"
                                                                     Aspect="AspectFill"
                                                                     WidthRequest="88"
                                                                     HeightRequest="88"
                                                                     CornerRadius="8"
                                                                     Command="{Binding OpenPhotoCommand, Source={RelativeSource AncestorType={x:Type viewModels:WorkOrderDetailsViewModel}}, x:DataType=viewModels:WorkOrderDetailsViewModel}"
                                                                     CommandParameter="{Binding .}"
                                                                     SemanticProperties.Description="{x:Static resources:AppResources.EntryPhotoDescription}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <Button Text="{x:Static resources:AppResources.DetailsShowLocationButton}"
                                                Command="{Binding OpenEntryLocationCommand, Source={RelativeSource AncestorType={x:Type viewModels:WorkOrderDetailsViewModel}}, x:DataType=viewModels:WorkOrderDetailsViewModel}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding HasLocation}"
                                                Style="{StaticResource OutlineButton}"
                                                Margin="0,8,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Details.PartsTotalText}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           IsVisible="{Binding Details.HasPartsTotal}" />

                    <Label Text="{x:Static resources:AppResources.DetailsHistorySection}"
                           Style="{StaticResource SectionLabel}" />
                    <Label Text="{x:Static resources:AppResources.DetailsNoHistory}"
                           Style="{StaticResource SecondaryLabel}"
                           IsVisible="{Binding Details.HasNoHistory}" />
                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Details.History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DeviceHistoryView">
                                <Border Style="{StaticResource CardBorder}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenHistoryItemCommand, Source={RelativeSource AncestorType={x:Type viewModels:WorkOrderDetailsViewModel}}, x:DataType=viewModels:WorkOrderDetailsViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <Label Text="{Binding Number}"
                                               FontAttributes="Bold" />
                                        <Border Grid.Column="1"
                                                Style="{StaticResource StatusBadge}">
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="12" />
                                        </Border>
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding DateText}"
                                               Style="{StaticResource SecondaryLabel}" />
                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Style="{StaticResource SecondaryLabel}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TechnicianName}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding EntryCountText}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="{x:Static resources:AppResources.DetailsDownloadProtocolButton}"
                            Command="{Binding DownloadProtocolCommand}"
                            IsVisible="{Binding Details.CanDownloadProtocol}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:LoadingView Grid.Row="2"
                              Style="{StaticResource ScreenOverlay}"
                              IsVisible="{Binding Screen.IsLoading}" />
        <controls:ErrorView Grid.Row="2"
                            Style="{StaticResource ScreenOverlay}"
                            IsVisible="{Binding Screen.IsError}"
                            Message="{Binding Screen.ErrorMessage}"
                            RetryCommand="{Binding RefreshCommand}" />
    </Grid>
</ContentPage>
